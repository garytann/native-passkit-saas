# Copy this file to .env and replace every placeholder secret.

# PostgreSQL
# Compose creates APP_DATABASE_NAME through the explicit db-init service.
APP_DATABASE_NAME=passkit_wip
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Backend
PUBLIC_BASE_URL=https://app.just-loyalty.com
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-bytes

# Business administration console
PLATFORM_ADMIN_EMAIL=admin@just-loyalty.com
PLATFORM_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Apple Wallet fallback identity
# Merchant-specific certificates, pass type IDs, designs, and assets are stored
# through the onboarding workflow. These values remain the platform fallback.
APPLE_PASS_TYPE_ID=pass.com.justloyalty.loyalty
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_ORGANIZATION_NAME=Just Loyalty
