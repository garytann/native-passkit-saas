# Copy this file to .env and replace every placeholder secret.

# PostgreSQL
# Compose creates APP_DATABASE_NAME through the explicit db-init service.
APP_DATABASE_NAME=passkit_wip
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Backend
PUBLIC_BASE_URL=https://app.just-loyalty.com
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-bytes

# Business administration console
PLATFORM_ADMIN_EMAIL=admin@just-loyalty.com
PLATFORM_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Apple Wallet fallback identity
# Merchant-specific certificates, pass type IDs, designs, and assets are stored
# through the onboarding workflow. These values remain the platform fallback.
APPLE_PASS_TYPE_ID=pass.com.justloyalty.loyalty
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_ORGANIZATION_NAME=Just Loyalty

# Google Wallet
# Keep disabled until the issuer account, service account, and class onboarding
# are ready. The JSON key path is resolved by Docker Compose and mounted as a
# read-only secret at /run/secrets/google_wallet_service_account.
GOOGLE_WALLET_ENABLED=false
GOOGLE_WALLET_ISSUER_ID=YOUR_GOOGLE_WALLET_ISSUER_ID
GOOGLE_WALLET_CREDENTIALS_FILE=./google-credentials/prod-service-account.json

# Merchant email verification (Google Workspace SMTP)
EMAIL_ENABLED=true
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=gary@justloyalty.com
EMAIL_FROM_NAME=Just Loyalty
EMAIL_FROM_ADDRESS=hello@justloyalty.com
EMAIL_REPLY_TO=hello@justloyalty.com
EMAIL_VERIFICATION_SECRET=replace-with-at-least-32-random-bytes
# Change this to ./email-credentials/google-workspace-app-password when enabling email.
EMAIL_SMTP_PASSWORD_SOURCE_FILE=./email-credentials/google-workspace-app-password
