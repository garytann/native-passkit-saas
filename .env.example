# Docker Compose host ports
PROXY_HOST_PORT=80
PROXY_HTTPS_HOST_PORT=443
POSTGRES_HOST_PORT=5432

# Postgres container provisioning
# POSTGRES_ADMIN_DB is the default database used for server health/admin tasks.
# APP_DATABASE_NAME is the application database created explicitly by db-init.
POSTGRES_ADMIN_DB=postgres
APP_DATABASE_NAME=passkit_wip
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Backend runtime
PORT=8080
# Use the public HTTPS origin served by the proxy.
PUBLIC_BASE_URL=https://loyalty.example.com
AUTH_TOKEN_SECRET=change-me-for-local-dev
# Optional long-lived token for administrator scripts. The web console uses the login below.
ADMIN_API_TOKEN=change-me-for-local-admin
# Used by the protected business administration console.
PLATFORM_ADMIN_EMAIL=admin@justloyalty.example
PLATFORM_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Optional for running the backend directly on your host without Compose.
# Docker Compose constructs its own DATABASE_URL using POSTGRES_*, APP_DATABASE_NAME, and db:5432.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/passkit_wip?sslmode=disable

# Web build
# Leave empty when using the Nginx proxy so the browser calls /api/v1 on the same origin.
VITE_API_BASE_URL=

# Apple Wallet pass signing
# New merchants use database-backed Pass Type and certificate configuration.
# These values remain as the platform Team ID and legacy pass fallback.
APPLE_PASS_TYPE_ID=pass.com.example.membership
APPLE_TEAM_ID=ABCDE12345
APPLE_ORGANIZATION_NAME=Example Company
# Optional override. Leave blank to use PUBLIC_BASE_URL + /api/v1/apple/passes.
APPLE_WEB_SERVICE_URL=
# APNs endpoint for Apple Wallet pass update pushes.
APPLE_APNS_ENDPOINT=https://api.push.apple.com

APPLE_PASS_CERT_PATH=certs/pass-cert.pem
APPLE_PASS_KEY_PATH=certs/pass-key.pem
# Uploaded merchant certificate aliases resolve beneath this persistent directory.
APPLE_CERTIFICATE_BASE_PATH=certs
# Uploaded merchant logo/icon aliases resolve beneath this persistent directory.
APPLE_PASS_ASSET_BASE_PATH=pass-assets
APPLE_WWDR_CERT_PATH=certs/wwdr.pem
OPENSSL_BIN=openssl
