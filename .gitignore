.env
.gocache/
tmp/
dist/
*.pkpass

web/node_modules/
web/dist/

# Keep real Apple credentials out of git.
certs/*
!certs/.gitkeep
!certs/README.md

# Merchant pass artwork is provisioned with each deployment.
pass-assets/*
!pass-assets/README.md

# Keep reverse-proxy TLS credentials out of git.
proxy/certs/*
!proxy/certs/.gitkeep
!proxy/certs/README.md
