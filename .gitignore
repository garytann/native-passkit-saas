.env
.env.*
!.env.example
!.env.*.example
.gocache/
tmp/
dist/
*.pkpass

web/node_modules/
web/dist/

# Keep real Apple credentials out of git.
certs/*
!certs/.gitkeep
!certs/README.md

# Merchant pass artwork is provisioned with each deployment.
pass-assets/*
!pass-assets/README.md

# Keep reverse-proxy TLS credentials out of git.
proxy/certs/*
!proxy/certs/.gitkeep
!proxy/certs/README.md

# Google service-account JSON keys are signing credentials.
google-credentials/*
!google-credentials/disabled.json
!google-credentials/README.md

# Google Workspace SMTP app passwords are deployment credentials.
email-credentials/*
!email-credentials/disabled
!email-credentials/README.md
