# Copy this file to .env.uat on the UAT server and replace every placeholder.

# PostgreSQL
# Preserve the existing value when deploying over an established UAT database.
APP_DATABASE_NAME=passkit_wip
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Backend
PUBLIC_BASE_URL=https://demo.grayworks.dev
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-bytes

# Business administration console
PLATFORM_ADMIN_EMAIL=admin@justloyalty.com
PLATFORM_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Apple Wallet fallback identity
# Merchant-specific certificates, pass type IDs, designs, and assets are stored
# through the onboarding workflow. These values remain the platform fallback.
APPLE_PASS_TYPE_ID=pass.com.justloyalty.loyalty
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_ORGANIZATION_NAME=Just Loyalty

# Google Wallet UAT issuer and service account. Keep these separate from prod.
GOOGLE_WALLET_ENABLED=false
GOOGLE_WALLET_ISSUER_ID=YOUR_UAT_GOOGLE_WALLET_ISSUER_ID
GOOGLE_WALLET_CREDENTIALS_FILE=./google-credentials/uat-service-account.json

# Merchant email verification (Gmail API with Workspace domain-wide delegation)
EMAIL_ENABLED=false
GMAIL_API_USER=gary@justloyalty.com
EMAIL_FROM_NAME=Just Loyalty
EMAIL_FROM_ADDRESS=hello@justloyalty.com
EMAIL_REPLY_TO=hello@justloyalty.com
EMAIL_VERIFICATION_SECRET=replace-with-at-least-32-random-bytes
# Replace with the UAT Gmail API service account key before enabling email.
GMAIL_API_CREDENTIALS_SOURCE_FILE=./email-credentials/disabled.json
